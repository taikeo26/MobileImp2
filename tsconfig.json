{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "DOM",
      "ES6",
      "ES2020"
    ],
    "module": "ES2020",
    "esModuleInterop": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": [
        "./node_modules/@dfreds/foundry-types/common/*"
      ],
      "@client/*": [
        "./node_modules/@dfreds/foundry-types/client/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}
